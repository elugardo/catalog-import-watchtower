# Catalog Import Watchtower: every environment variable, with safe placeholders.
# Copy to `.env` (git-ignored) and edit. The stack runs with no `.env` at all:
# compose.yaml and app/settings.py carry the defaults shown here.
# See _docs/operations.md -> Configuration.

# --- app and oncall-agent -----------------------------------------------------

# SQLAlchemy URL of the PostgreSQL database (psycopg 3 driver). This default
# is the Compose `db` service as seen from the host (`uv run uvicorn`, tests);
# inside Compose the containers always use the `db` hostname.
DATABASE_URL=postgresql+psycopg://ciw:ciw@localhost:5432/ciw

# Seconds psycopg waits for a connection; bounds /api/health while the db is down.
DATABASE_CONNECT_TIMEOUT_SECONDS=2

# `true` lets the worker claim alerts; the app reports the value on /api/health.
AGENT_ENABLED=false

# Folder of the built SPA served at `/` (only for uvicorn on the host).
STATIC_DIR=app/static

# --- oncall-agent only (needed when AGENT_ENABLED=true) -----------------------

# LLM provider of the on-call worker. Only `anthropic` is supported; any other
# value keeps the worker idle.
LLM_PROVIDER=anthropic

# Model name, as the provider spells it (for example claude-haiku-5-5). Left
# empty here on purpose: the worker stays idle ("LLM_MODEL is not set") until a
# real model name is set in `.env`, instead of claiming alerts with a placeholder.
LLM_MODEL=

# Anthropic API key. Optional: without it the worker stays idle, alerts stay
# OPEN and the app works as usual. Get one at https://console.anthropic.com
# (Settings -> API keys). Read by `oncall-agent` only: compose.yaml passes it
# to no other service, CI and deployed environments have none, and it is
# never logged or stored. Put the real value in `.env`, never here.
ANTHROPIC_API_KEY=

# Worker loop tuning: poll interval, stale-claim timeout, tool-call budget,
# per-run timeout (seconds / seconds / count / seconds).
AGENT_POLL_SECONDS=10
AGENT_CLAIM_TIMEOUT_SECONDS=300
AGENT_MAX_TOOL_CALLS=8
AGENT_TIMEOUT_SECONDS=120

# --- telemetry (app/telemetry.py; _docs/operations.md -> Telemetry) -----------

# The Compose defaults. OTLP/HTTP endpoint of the otel-lgtm container.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318
# Per process: compose.yaml sets ciw-app for `app` and ciw-oncall-agent for
# `oncall-agent` (the CLI uses its container's name).
OTEL_SERVICE_NAME=ciw-app
# `false` exports traces, metrics and logs (the local stack). The tests
# (compose.test.yaml) and the deployed environments (fly.toml, fly.prod.toml)
# use `true`; unset outside Compose also means off.
OTEL_SDK_DISABLED=false

# --- compose only -------------------------------------------------------------

# Host port that maps to the app container's 8000.
APP_PORT=8000

# Host port that maps to the db container's 5432 (change it when a local
# PostgreSQL already owns 5432; then point DATABASE_URL above at the new port).
DB_PORT=5432

# Host port that maps to Grafana (otel-lgtm container's 3000); change it to run a
# second Compose project (-p <name>) beside the default one.
GRAFANA_PORT=3000

# Image build argument that becomes `version` on /api/health ("dev" when unset;
# CI sets it to the commit SHA).
APP_VERSION=dev
